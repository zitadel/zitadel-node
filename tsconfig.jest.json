{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "isolatedModules": true,
    "allowJs": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "#transport": ["./src/default-api-client.ts"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}
